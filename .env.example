# ============================================================
# ERP-Aware Data Transformation Pipeline - environment template
#
# Copy this file to .env and fill in real values. Never commit .env.
# Every variable below is the CANONICAL name. The legacy names listed in the
# comments still work as deprecated fallbacks, but they print a deprecation
# warning. If a canonical and a legacy variable are both set and disagree, the
# canonical value wins and a warning is printed.
# ============================================================

# ------------------------------------------------------------
# Simulated legacy ERP source database (bpi2020_old_erp_db)
# Legacy names: BPI_OLD_DB_*, OLD_DB_*
# ------------------------------------------------------------
ERP_SOURCE_DB_HOST=localhost
ERP_SOURCE_DB_PORT=5432
ERP_SOURCE_DB_NAME=bpi2020_old_erp_db
ERP_SOURCE_DB_USER=postgres
ERP_SOURCE_DB_PASSWORD=change_me

# ------------------------------------------------------------
# AI-native pipeline database (erp_ai_native_db)
# Legacy names: AI_DB_*
# ------------------------------------------------------------
PIPELINE_DB_HOST=localhost
PIPELINE_DB_PORT=5432
PIPELINE_DB_NAME=erp_ai_native_db
PIPELINE_DB_USER=postgres
PIPELINE_DB_PASSWORD=change_me

# ------------------------------------------------------------
# Vector database (Qdrant Cloud or a local Qdrant server)
# Legacy names: QDRANT_URL, QDRANT_API_KEY, QDRANT_COLLECTION,
#               QDRANT_HOST, QDRANT_PORT, QDRANT_TIMEOUT_SECONDS,
#               QDRANT_RECREATE_COLLECTION
#
# Leave VECTOR_DB_URL and VECTOR_DB_API_KEY empty to use the local fallback
# defined by VECTOR_DB_HOST / VECTOR_DB_PORT.
# ------------------------------------------------------------
VECTOR_DB_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
VECTOR_DB_API_KEY=replace_with_your_qdrant_cloud_api_key
VECTOR_COLLECTION=bpi2020_erp_knowledge
VECTOR_DB_TIMEOUT_SECONDS=60

# Local Qdrant fallback; ignored when VECTOR_DB_URL is set.
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333

# Deleting and rebuilding the collection is destructive and off by default.
# The uploader uses deterministic point IDs, so a normal rerun safely upserts.
VECTOR_DB_RECREATE_COLLECTION=false

# ------------------------------------------------------------
# Embedding model
# Legacy name: EMBEDDING_MODEL
# ------------------------------------------------------------
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# ------------------------------------------------------------
# OCR (only needed when parsing scanned images or scanned PDFs)
# Legacy name: TESSERACT_PATH
#
# Used by the Phase 0 document parser and by Phase 6 file ingestion
# (erp_pipeline.ingestion). Leave unset to fall back to PATH discovery; when
# Tesseract is unavailable, image/scanned-PDF ingestion reports an explicit
# "OCR unavailable" state rather than returning empty text.
# ------------------------------------------------------------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ------------------------------------------------------------
# Phase 5 MongoDB observed-schema inference - live verification only
#
# An ISOLATED MongoDB instance used solely to verify document inference. The
# tests create and drop the `erp_phase5_test` database themselves and touch
# nothing else. Leave the passwords empty to skip the live MongoDB tests.
#
# Fixtures seed data with the admin account; DISCOVERY runs with the read-only
# account, which should hold only the `read` role on the test database.
# ------------------------------------------------------------
MONGO_PHASE5_HOST=localhost
MONGO_PHASE5_PORT=27018
MONGO_PHASE5_DB=erp_phase5_test
MONGO_PHASE5_AUTH_DB=admin
MONGO_PHASE5_ADMIN_USER=phase5_admin
MONGO_PHASE5_ADMIN_PASSWORD=
MONGO_PHASE5_READONLY_USER=phase5_reader
MONGO_PHASE5_READONLY_PASSWORD=

# ------------------------------------------------------------
# Near-real-time incremental sync
# ------------------------------------------------------------
SYNC_POLL_INTERVAL_SECONDS=10
SYNC_BATCH_SIZE=1000

# ======================================================================
# PHASE 13 RUNTIME (deployment hardening)
# Every variable below is read by src/erp_pipeline/runtime/settings.py or
# src/erp_pipeline/api/config.py. Example values only - never real secrets.
# ======================================================================

# ---- REST API ----
# Loopback by default. Binding a routable address without ERP_API_KEY is
# refused at startup (see ERP_ALLOW_INSECURE_BIND).
ERP_API_HOST=127.0.0.1
ERP_API_PORT=8000
# Required for any non-loopback bind. Protects POST/PUT/DELETE.
ERP_API_KEY=
# Set true to require the key on reads as well.
ERP_API_PROTECT_READS=false
# Comma-separated. Empty means no cross-origin browser access.
ERP_API_CORS_ORIGINS=
ERP_API_MAX_UPLOAD_BYTES=67108864
ERP_API_UPLOAD_DIR=var/uploads
# Advertised in /v1/capabilities. Leave false until SQL Server is verified.
ERP_SQL_SERVER_LIVE_VERIFIED=false

# ---- AI-native PostgreSQL ----
# The PIPELINE_DB_* block above configures this. All five generic schemas
# (erp_catalog, erp_sync, erp_vector_storage, erp_orchestration, erp_runtime)
# live in that one database.
# Create/verify them with: python -m erp_pipeline.runtime.bootstrap
ERP_BOOTSTRAP_ON_STARTUP=true

# ---- Generic vector storage (Qdrant) ----
# Deliberately separate from the BPI VECTOR_DB_* block: those point at the
# BPI prototype's own collection and must not be inherited by generic code.
ERP_QDRANT_ENABLED=true
# For a managed cluster set the URL; otherwise host/port are used.
ERP_QDRANT_URL=
ERP_QDRANT_HOST=localhost
ERP_QDRANT_PORT=6333
ERP_QDRANT_API_KEY=
ERP_QDRANT_HOT_COLLECTION=erp_vectors_hot
ERP_QDRANT_WARM_COLLECTION=erp_vectors_warm
ERP_QDRANT_DIMENSION=384
ERP_QDRANT_TIMEOUT_SECONDS=60

# ---- COLD encrypted archive ----
ERP_COLD_ENABLED=true
ERP_COLD_ARCHIVE_DIR=var/cold-archive
# 32 bytes, base64. REQUIRED when COLD is enabled - startup fails without it
# rather than writing archives unencrypted. Losing this key makes every
# existing archive permanently unreadable, so escrow it.
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ERP_COLD_ARCHIVE_KEY=

# ---- Source credentials ----
# A registered source stores a credential_ref (a NAME), never a password.
# At connect time the reference resolves to ERP_SECRET_<REF>, upper-cased.
# Example: a source registered with credential_ref "erp_finance_pw" reads:
# ERP_SECRET_ERP_FINANCE_PW=

# ---- Worker pool ----
ERP_EXECUTOR_WORKERS=2
ERP_EMBEDDING_ENABLED=true

# ---- Deliberate escape hatch ----
# Allows binding a non-loopback address with no API key. Only for an isolated
# experiment; never for a deployment reachable by anyone else.
ERP_ALLOW_INSECURE_BIND=false
