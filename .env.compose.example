# Copy to .env.compose and replace every value before starting Docker Compose.
# Keep .env.compose out of Git. These values are examples, not credentials.
PIPELINE_DB_PASSWORD=replace-with-a-long-random-database-password
ERP_API_KEY=replace-with-a-long-random-pipeline-api-key
ERP_FILTER_TOKEN_KEY=replace-with-a-long-random-filter-token-key

