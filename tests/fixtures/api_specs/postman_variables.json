{
  "info": {
    "name": "ERP Variables",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://erp.example.invalid"
    },
    {
      "key": "invoiceId",
      "value": "INV-4242"
    }
  ],
  "item": [
    {
      "name": "Get Invoice By Variable",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/invoices/{{invoiceId}}?tenant={{tenantCode}}",
          "path": [
            "invoices",
            "{{invoiceId}}"
          ],
          "query": [
            {
              "key": "tenant",
              "value": "{{tenantCode}}"
            }
          ]
        }
      }
    }
  ]
}