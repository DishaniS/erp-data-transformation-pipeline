# ----------------------------------------------------------------------
# Frontend configuration.
#
# This file must NEVER contain a backend secret. The database password, the
# Qdrant API key and the cold-archive key all belong to the backend process
# and are read from the repository-root .env. Anything placed here is shipped
# to the browser in the built bundle.
# ----------------------------------------------------------------------

# Where the Phase 13 API is served.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Only set this if the backend was started with ERP_API_KEY. It is held in
# memory for the session and is never written to localStorage. For ordinary
# loopback development leave it empty.
VITE_API_KEY=
